{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "user_flows.json",
  "type": "object",
  "required": ["flows"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["flow_id", "actor", "action", "screen", "result", "satisfies"],
        "additionalProperties": false,
        "properties": {
          "flow_id": { "type": "string", "pattern": "^FL-[0-9]+$" },
          "actor": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "screen": { "type": "string", "minLength": 1 },
          "result": { "type": "string", "minLength": 1 },
          "satisfies": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
