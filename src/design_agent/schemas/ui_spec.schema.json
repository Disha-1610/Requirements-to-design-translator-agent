{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ui_spec.json",
  "type": "object",
  "required": ["screens"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["screen", "module", "fields", "actions", "success_state", "error_state", "satisfies"],
        "additionalProperties": false,
        "properties": {
          "screen": { "type": "string", "minLength": 1 },
          "module": { "type": "string", "minLength": 1 },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "required", "error_ids"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "minLength": 1 },
                "required": { "enum": ["y", "n"] },
                "error_ids": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "actions": { "type": "array", "items": { "type": "string" } },
          "success_state": { "type": "string" },
          "error_state": { "type": "string" },
          "satisfies": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
