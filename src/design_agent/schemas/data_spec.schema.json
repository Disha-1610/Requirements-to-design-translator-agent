{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data_spec.json",
  "type": "object",
  "required": ["fields", "state_transitions", "fixtures"],
  "properties": {
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["entity", "name", "type"],
        "properties": {
          "entity": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "format": { "type": ["string", "null"] },
          "length": { "type": ["integer", "null"] },
          "example": { "type": ["string", "number", "boolean", "null"] },
          "required": { "type": ["boolean", "null"] },
          "primary_key": { "type": "boolean" },
          "foreign_key": {
            "type": ["string", "null"],
            "pattern": "^[^.\\s]+\\.[^.\\s]+$"
          },
          "fk_cardinality": {
            "type": ["string", "null"],
            "enum": ["many-to-one", "one-to-one", "many-to-many", null],
            "description": "Relationship cardinality for this foreign key. Defaults to many-to-one when absent."
          }
        }
      }
    },
    "state_transitions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["from", "to"],
          "properties": {
            "from": { "type": "string" },
            "to": { "type": "string" },
            "trigger": { "type": "string" },
            "fixtures": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": { "id": { "type": "string", "minLength": 1 } }
      }
    },
    "derived_fields": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Normalized field names (lowercase, no separators) that may appear in UI/API without a data_spec origin. Merged with the built-in DERIVED_FIELDS list in constants.py."
    }
  }
}
