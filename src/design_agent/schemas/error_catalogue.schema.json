{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "error_catalogue.json (normalized: array of error records)",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["error_id", "name", "http_status", "user_message", "notes"],
    "properties": {
      "error_id": { "type": "string", "pattern": "^ERR-[0-9]{3,}$" },
      "name": { "type": "string" },
      "http_status": { "type": "integer", "minimum": 100, "maximum": 599 },
      "user_message": { "type": "string" },
      "notes": { "type": "string" }
    }
  }
}
