{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "validation_checklist.json",
  "type": "object",
  "required": ["checks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["requirement_id", "has_validation", "error_id", "screen", "field"],
        "additionalProperties": false,
        "properties": {
          "requirement_id": { "type": "string" },
          "has_validation": { "type": "boolean" },
          "error_id": { "type": ["string", "null"] },
          "screen": { "type": ["string", "null"] },
          "field": { "type": ["string", "null"] }
        }
      }
    }
  }
}
